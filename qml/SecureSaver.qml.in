import QtQuick
import Quickshell
import Quickshell.Io
import @@RENDERER_URL@@ as Native

// The owning lock surface and authentication stay in Omarchy's lock plugin.
Item {
  id: root
  property bool active: false
  property string art: "OMARCHY"
  property var runs: []
  property bool displayPowered: true
  property bool closing: false
  property int receivedFrames: 0
  property double previousPaintCount: 0
  property int sampleCount: 0
  property double sampleStarted: 0
  readonly property real targetFps: @@FPS@@
  readonly property bool metricsEnabled: @@METRICS@@
  readonly property int cellFontSize: Math.max(8, Math.min(20, Math.floor(width / 105), Math.floor(height / 15)))
  readonly property int columns: Math.max(40, Math.min(300, Math.floor((width - 4) / terminalRenderer.cellWidth)))
  readonly property int rows: Math.max(16, Math.min(120, Math.floor((height - 4) / terminalRenderer.cellHeight)))
  readonly property bool shouldRun: active && displayPowered && visible && width > 0 && height > 0 && !closing
  signal dismissed()
  visible: active

  function stopChildren() {
    startTimer.stop()
    retryTimer.stop()
    frameProcess.running = false
    runs = []
  }

  function scheduleStart() {
    stopChildren()
    if (shouldRun) startTimer.restart()
  }

  onActiveChanged: {
    if (active && metricsEnabled) {
      receivedFrames = 0
      previousPaintCount = terminalRenderer.paintCount
      sampleCount = 0
      sampleStarted = Date.now()
    }
    scheduleStart()
  }
  onShouldRunChanged: scheduleStart()
  onVisibleChanged: scheduleStart()
  onColumnsChanged: scheduleStart()
  onRowsChanged: scheduleStart()
  Component.onCompleted: scheduleStart()
  Component.onDestruction: {
    closing = true
    stopChildren()
  }

  // Lock surface geometry arrives after activation; settle the whole-screen
  // grid first, instead of starting an effect on the minimum 40x16 canvas.
  Timer {
    id: startTimer
    interval: 100
    repeat: false
    onTriggered: {
      if (!root.shouldRun) return
      if (frameProcess.running) restart()
      else frameProcess.running = true
    }
  }

  // DPMS does not hide the Wayland surface. Poll only while the saver is
  // selected; stopping rendering must leave this low-frequency wake probe alive.
  Timer {
    interval: 2000
    repeat: true
    triggeredOnStart: true
    running: root.active && !root.closing
    onTriggered: if (!powerProbe.running) powerProbe.running = true
  }

  Process {
    id: powerProbe
    command: ["hyprctl", "-j", "monitors"]
    stdout: StdioCollector { id: powerOutput; waitForEnd: true }
    onExited: function(exitCode) {
      if (exitCode !== 0 || !root.active || root.closing) return
      try {
        let monitors = JSON.parse(powerOutput.text)
        if (!Array.isArray(monitors)) return
        let screen = root.Window.window ? root.Window.window.screen : null
        let name = screen ? screen.name : ""
        let output = monitors.find(m => m.name === name)
        // Each lock surface follows its own output. Preview/offscreen windows
        // without a matching output follow whether any enabled output is lit.
        root.displayPowered = output
          ? !output.disabled && output.dpmsStatus === true
          : monitors.some(m => !m.disabled && m.dpmsStatus === true)
      } catch (error) { /* Preserve the last known state if IPC is unavailable. */ }
    }
  }

  FileView {
    path: (Quickshell.env("HOME") || "") + "/.config/omarchy/branding/screensaver.txt"
    watchChanges: true
    printErrors: false
    onLoaded: {
      let value = String(text() || "").replace(/\s+$/, "")
      root.art = value !== "" ? value : "OMARCHY"
    }
    onFileChanged: reload()
  }

  Process {
    id: frameProcess
    command: [@@PYTHON@@, @@BRIDGE@@,
              "--cols", String(root.columns), "--rows", String(root.rows),
              "--fps", String(root.targetFps)]
    stdout: SplitParser {
      onRead: function(line) {
        if (!root.shouldRun || line.length > 8 * 1024 * 1024) return
        try {
          let next = JSON.parse(line)
          if (next && Array.isArray(next.runs) && next.runs.length <= root.columns * root.rows) {
            root.runs = next.runs
            if (root.metricsEnabled) root.receivedFrames++
          }
        } catch (error) {
          console.warn("secure screensaver: discarded invalid frame")
        }
      }
    }
    onExited: if (root.shouldRun && !startTimer.running) retryTimer.restart()
  }

  Timer {
    id: retryTimer
    interval: 2000
    repeat: false
    onTriggered: if (root.shouldRun && !frameProcess.running) frameProcess.running = true
  }

  // Actual native paint callbacks, never inferred from JSON delivery. Disabled
  // unless explicitly requested; only three samples, without persistent logs.
  Timer {
    interval: 5000
    running: root.metricsEnabled && root.shouldRun && root.sampleCount < 3
    repeat: true
    onTriggered: {
      let now = Date.now()
      let seconds = (now - root.sampleStarted) / 1000
      if (seconds > 0 && root.sampleStarted > 0)
        console.log("lock-saver-fps", JSON.stringify({
          received: root.receivedFrames / seconds,
          painted: (terminalRenderer.paintCount - root.previousPaintCount) / seconds,
          seconds: seconds, columns: root.columns, rows: root.rows,
          width: root.width, height: root.height
        }))
      root.receivedFrames = 0
      root.previousPaintCount = terminalRenderer.paintCount
      root.sampleStarted = now
      root.sampleCount++
    }
  }

  Rectangle { anchors.fill: parent; color: "#000000" }

  Text {
    anchors.centerIn: parent
    visible: root.runs.length === 0
    textFormat: Text.PlainText
    text: root.art
    font.family: "monospace"
    font.pixelSize: root.cellFontSize
    color: "#55cc55"
    horizontalAlignment: Text.AlignHCenter
    wrapMode: Text.NoWrap
  }

  Native.TerminalFrame {
    id: terminalRenderer
    anchors.fill: parent
    visible: root.runs.length > 0
    cellFontSize: root.cellFontSize
    runs: root.runs
  }

  MouseArea {
    anchors.fill: parent
    hoverEnabled: true
    property real startX: -1
    property real startY: -1
    onVisibleChanged: { startX = -1; startY = -1 }
    onPositionChanged: function(mouse) {
      if (startX < 0) { startX = mouse.x; startY = mouse.y; return }
      if (Math.abs(mouse.x - startX) + Math.abs(mouse.y - startY) > 16) root.dismissed()
    }
    onClicked: root.dismissed()
  }
}
