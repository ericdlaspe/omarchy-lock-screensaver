#!/usr/bin/env bash
# Real Qt plugin + offscreen Quickshell + ttfx; never changes live lock config.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
python=${PYTHON:-python3}
mkdir -p -- "$root/build"
generation=$(mktemp -d "$root/build/native-tests.XXXXXXXX")
"$root/scripts/build-native" "$generation/module"
mkdir -- "$generation/tests"
(
  cd -- "$generation/tests"
  qmake6 "$root/tests/native/tests.pro"
  make -j"${JOBS:-2}"
)
export LOCKSAVER_MODULE_URL
LOCKSAVER_MODULE_URL=$("$python" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).as_uri())' "$generation/module")
QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME= QSG_RHI_BACKEND=software \
  QSG_RENDER_LOOP=basic "$generation/tests/renderer-test" -nocrashhandler
"$python" -m unittest discover -s "$root/tests" -v
